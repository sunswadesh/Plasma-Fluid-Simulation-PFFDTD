\@writefile{lof}{\contentsline {figure}{\numberline {9.1}{\ignorespaces Low-frequency CW findings, 0.50--1.50~MHz. Top: \(\operatorname  {Re}\{Z\}\); bottom: \(\operatorname  {Im}\{Z\}\). \(S_d=0\) (blue) remains inductive. \(S_d=2\) (orange) shows a brief inductive island at 0.60~MHz then returns to capacitive. \(S_d=10\) (green) is capacitive at every point. The sharp drop in \(S_d=0\) at 1.50~MHz is the incomplete August file and must be ignored.}}{28}{figure.caption.37}\protected@file@percent }
\newlabel{fig:lowf-z}{{9.1}{28}{Low-frequency CW findings, 0.50--1.50~MHz. Top: \(\ReZ \); bottom: \(\ImZ \). \(\Sd =0\) (blue) remains inductive. \(\Sd =2\) (orange) shows a brief inductive island at 0.60~MHz then returns to capacitive. \(\Sd =10\) (green) is capacitive at every point. The sharp drop in \(\Sd =0\) at 1.50~MHz is the incomplete August file and must be ignored}{figure.caption.37}{}}
