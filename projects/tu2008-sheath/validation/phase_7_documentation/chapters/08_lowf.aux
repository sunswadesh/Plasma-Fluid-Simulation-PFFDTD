\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces Combined findings for \(S_d=0,2,10\) over 0.50--2.30~MHz. Shaded region: September low-frequency extension. \(S_d=0\) alone shows the high-band inductive-to-capacitive transition; \(S_d\ge 2\) stay on the capacitive side through the August band.}}{30}{figure.caption.39}\protected@file@percent }
\newlabel{fig:lowf-full}{{9.2}{30}{Combined findings for \(\Sd =0,2,10\) over 0.50--2.30~MHz. Shaded region: September low-frequency extension. \(\Sd =0\) alone shows the high-band inductive-to-capacitive transition; \(\Sd \ge 2\) stay on the capacitive side through the August band}{figure.caption.39}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9.6}What remains for this band}{30}{section.9.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.3}{\ignorespaces Headline resonance finding: \(f_{\mathrm  {res}}(S_d)\) from Im\(\{Z\}\) \(+\) to \(-\) crossings. Wider sheath moves the crossing \emph  {downward} (\(1.85\to 0.66\to \lesssim 0.50\)~MHz), opposite to the Tu-inspired upward-shift target toward free space.}}{31}{figure.caption.41}\protected@file@percent }
\newlabel{fig:lowf-res}{{9.3}{31}{Headline resonance finding: \(\fres (\Sd )\) from Im\(\{Z\}\) \(+\) to \(-\) crossings. Wider sheath moves the crossing \emph {downward} (\(1.85\to 0.66\to \lesssim 0.50\)~MHz), opposite to the Tu-inspired upward-shift target toward free space}{figure.caption.41}{}}
